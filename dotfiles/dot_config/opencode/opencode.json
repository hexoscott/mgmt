{
  "$schema": "https://opencode.ai/config.json",
  "model": "turbofieldfare/gemma-4-26b-a4b-it",
  "agent": {
    "build": {
      "prompt": "{file:./prompts/local.txt}",
      "reasoningEffort": "medium",
      "permission": {
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "task": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "question": "deny"
      }
    }
  },
  "provider": {
    "turbofieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Turbo Fieldfare (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B-A4B IT",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-4-31b": {
          "name": "Gemma 4 31B (local)"
        },
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B (local)",
          "reasoning": true,
          "limit": {
            "context": 100000,
            "output": 32000
          }
        },
        "qwen3.6-27b-mlx": {
          "name": "Qwen 3.6 27B MLX (local)"
        }
      }
    }
  }
}
